# =============================================================================
# CricketApp environment configuration (production defaults: real SMTP + 2factor
# SMS — NO test mode). Copy this to `.env` and fill in the real secrets.
# Never commit the real `.env` — it contains credentials.
# =============================================================================

# PostgreSQL (Docker): postgresql+asyncpg://USER:PASS@cricketdb:5432/moviedb
# SQLite (local):      sqlite+aiosqlite:///./cricket.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@cricketdb:5432/moviedb


# Comma-separated list of browser origins allowed to call the API. Unset means
# the dev defaults in app/main.py (localhost:5173) apply, which will NOT work in
# production. Set this to your real web client's origin, e.g.
# CORS_ORIGINS=https://app.example.com,https://example.com
#
# Scheme and port are part of the origin and must match exactly: an https site
# is a different origin from its http twin, and :5173 is not :443. Only add a
# host you control - any listed origin can read authenticated responses.
CORS_ORIGINS=

# Optional regular expression for origins CORS_ORIGINS cannot express as a
# literal list, e.g. many preview subdomains:
#   CORS_ORIGINS_REGEX=https://.*\.example\.com
# Leave empty unless you need it. Since credentials are enabled, a bare "*" is
# rejected by browsers; this matches specific hosts instead, which is legal.
CORS_ORIGINS_REGEX=


# --- Authentication (JWT) ---
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json


# --- SMS OTP provider (real 2factor, NOT test) ---
# Providers: test | 2factor | twilio | msg91
SMS_PROVIDER=2factor
TWO_FACTOR_API_KEY=YOUR_2FACTOR_API_KEY

# Twilio (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# MSG91 (only if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=

# Only used when SMS_PROVIDER=test (kept for safety, not active)
TEST_OTP_CODE=123456


# --- Email OTP provider (real SMTP, NOT test) ---
# Email is always sent via real SMTP when EMAIL_PROVIDER=smtp (production).
#   - Port 587 (TLS):   SMTP_TLS=true,  SMTP_SSL=false
#   - Port 465 (SSL):   SMTP_TLS=false, SMTP_SSL=true
#   - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true,
#     SMTP_PASSWORD = an App Password (requires Google 2-Step Verification)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_FROM=you@example.com
SMTP_TLS=true
SMTP_SSL=false


# --- Push notifications (OneSignal) ---
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
