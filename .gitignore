# Python
venv/
__pycache__/
*.pyc

# Secrets - DO NOT COMMIT
.env
.env.*
!.env.example
firebase-service-account.json

# Database
# Covers cricket.db plus the .bak / .pre-player-identity / .snapshot-* copies
# left behind by local migration work. They are real databases holding player
# phone numbers and must never be committed.
cricket.db
cricket.db.*
*.sqlite3
*.sqlite3.*

# Logs
*.log

# Runtime uploads
uploads/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local deploy keys, never commit
.keys/
*.pem

# Throwaway diagnostic scripts and exports from ad-hoc debugging sessions. These
# are scratch files, not part of the app, and one of them was a 1.8 MB database
# export that `git add -A` nearly staged. Ignoring them also keeps ruff's
# repo-wide checks from failing on files nobody is maintaining.
tmp_*

